# Copiar a `.env` (gitignored) antes de `docker compose -f compose.local.yaml up`.
# Todos los secretos aquí son de PRUEBA LOCAL — nunca usar estos valores tal
# cual en un ambiente real.

# --- Metadata de build (usada por scripts/build-local.sh) ---
APP_VERSION=0.0.1-local
GIT_COMMIT_BACKEND=unknown
GIT_COMMIT_FRONTEND=unknown
BUILD_DATE=unknown

# --- Backend NestJS (services-prep-2027) ---
# Mínimo 16 caracteres (lo exige src/config/env.validation.ts).
JWT_SECRET=cambia-este-secreto-local-de-prueba-1234
JWT_EXPIRES_IN=1h

# Secreto HMAC compartido con el Extractor/Difusor para firmar el manifest de
# cada corte (ver docs/API-CORTES-SQLITE.md). Mínimo 16 caracteres.
CORTES_MANIFEST_HMAC_SECRET=cambia-este-secreto-hmac-local-5678

CORTES_MAX_UPLOAD_MB=100
CORTES_UPLOAD_RATE_LIMIT=5

# Orígenes permitidos por CORS (coma-separado). Para probar solo desde el
# propio contenedor (frontend servido por el mismo NestJS) no hace falta
# agregar nada más que el propio origen local.
CORS_ORIGINS=http://localhost:3000

# --- Difusor de prueba (scripts/send-test-cut.sh) ---
# "sub" que llevará el JWT que el script firma para autenticarse como
# difusor contra JwtDifusorGuard.
DIFUSOR_SUBJECT=difusor-simulado-local
