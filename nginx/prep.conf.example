# Ejemplo de proxy inverso Nginx -> contenedor prep-2027
# (Node/NestJS escuchando solo en 127.0.0.1:3000, nunca expuesto directamente).
#
# Reemplazar:
#   TU_DOMINIO.example      -> dominio real (p. ej. prep2027-int.iecm.mx)
#   /ruta/a/fullchain.pem   -> certificado real
#   /ruta/a/privkey.pem     -> llave privada real del certificado TLS
#     (placeholders — NUNCA commitear certificados/llaves reales)
#
# Aplicar: sudo nginx -t && sudo systemctl reload nginx

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name TU_DOMINIO.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name TU_DOMINIO.example;

    ssl_certificate     /ruta/a/fullchain.pem;
    ssl_certificate_key /ruta/a/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # --- Carga de cortes (POST /api/v1/cortes) ---
    # El default de Nginx es 1m y rechaza los cortes con 413 antes de llegar a
    # la app. Debe ser mayor a CORTES_MAX_UPLOAD_MB (100) + overhead multipart.
    client_max_body_size 110m;
    proxy_request_buffering off;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSockets (gateways de NestJS)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    access_log /var/log/nginx/prep-2027-access.log;
    error_log  /var/log/nginx/prep-2027-error.log;
}
